# =========================
# HASH
# =========================
def get_file_hash(path):
    if not os.path.exists(path):
        return None

    sha256 = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(4096), b""):
            sha256.update(chunk)
    return sha256.hexdigest()


def extract_version(content_bytes):
    try:
        content = content_bytes.decode()
        match = re.search(r'VERSION\s*=\s*["\'](.+?)["\']', content)
        if match:
            return match.group(1)
    except:
        pass
    return None


# =========================
# UPDATE
# =========================
def update_script(auto=False):
    if not auto:
        print("\n[+] Checking updates...")

    try:
        with urllib.request.urlopen(GITHUB_RAW_URL, timeout=10) as response:
            latest_script = response.read()

        if hashlib.sha256(latest_script).hexdigest() == get_file_hash(script_path):
            if not auto:
                print("[=] Already updated.")
            return

        print("[+] New version found!")

        backup = script_path + ".bak"
        if os.path.exists(script_path):
            os.replace(script_path, backup)

        temp = script_path + ".tmp"
        with open(temp, "wb") as f:
            f.write(latest_script)

        os.replace(temp, script_path)

        print("[✔] Update done! Restart script.")

    except Exception as e:
        if not auto:
            print(f"[!] Update error: {e}")

    time.sleep(2)


# =========================
# NMAP RUNNER
# =========================
def run_nmap(command):
    process = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )

    with tqdm(total=100, desc="Scanning", unit="%") as pbar:
        for line in process.stdout:
            print(line.strip())

            match = re.search(r"(\d+)% done", line)
            if match:
                pbar.n = int(match.group(1))
                pbar.refresh()

        process.wait()


# =========================
# SCANS
# =========================
def scan_quick(target):
    return ["nmap", "-F", "-sV", "-oN", f"quick_{target}.txt", target]


def scan_full(target):
    cmd = ["nmap", "-sS", "-p-", "-sV", "-oN", f"full_{target}.txt", target]
    if not IS_WINDOWS:
        cmd.insert(0, "sudo")
    return cmd


def scan_udp(target):
    cmd = ["nmap", "-sU", "--top-ports", "200", "-oN", f"udp_{target}.txt", target]
    if not IS_WINDOWS:
        cmd.insert(0, "sudo")
    return cmd


def run_scan(choice):
    print_banner()

    if shutil.which("nmap") is None:
        print("[!] Nmap non installato")
        return

    target = input("Target: ").strip()

    if choice == "1":
        cmd = scan_quick(target)
    elif choice == "2":
        cmd = scan_full(target)
    elif choice == "3":
        cmd = scan_udp(target)
    else:
        print("Errore scelta")
        return

    print("\n[+] Scanning...\n")
    run_nmap(cmd)

    print("\n[✔] Scan completata")


# =========================
# MENU
# =========================
def main_menu():
    while True:
        print_banner()
        print("1 - Quick Scan")
        print("2 - Full Scan")
        print("3 - UDP Scan 🔥")
        print("4 - Update")
        print("5 - Help")
        print("0 - Exit")

        choice = input(">> ").strip()

        if choice in ["1", "2", "3"]:
            run_scan(choice)
        elif choice == "4":
            update_script()
        elif choice == "5":
            print("Tool di network scanning avanzato.")
        elif choice == "0":
            sys.exit(0)
        else:
            print("Opzione non valida")


# =========================
# START
# =========================
if __name__ == "__main__":
    update_script(auto=True)
    main_menu()
