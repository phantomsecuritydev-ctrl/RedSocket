# =========================
# SCAN EXECUTION
# =========================
def run_command(command, saved_file=None):
    log_command(command)

    print(C.YELLOW + "\n[+] Running: " + " ".join(command) + C.RESET)

    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

    if process.stdout:
        for line in process.stdout:
            print(line.rstrip())

    process.wait()

    print(C.GREEN + "\n[✔] Scan completed" + C.RESET)
    if saved_file:
        print(C.CYAN + f"[📄] Saved to: {saved_file}" + C.RESET)

    input("\nPress Enter to return to menu...")

# =========================
# MENU
# =========================
def main_menu():
    while True:
        print_banner()

        print("=== MENU ===")
        print("1 - Quick TCP Scan")
        print("2 - Full TCP Scan")
        print("3 - UDP Scan")
        print("4 - Vulnerability Scan")
        print("5 - Custom Command")
        print("6 - Masscan Scan")
        print("7 - Exit")

        choice = input(C.CYAN + "\n>> " + C.RESET).strip()

        if choice == "7":
            sys.exit()

        if choice == "5":
            cmd = input("Command >> ").strip().split()
            if cmd:
                run_command(cmd)
            continue

        target = input("Target >> ").strip()

        if not resolve_host(target):
            print(C.BLOOD + "[!] Invalid target" + C.RESET)
            time.sleep(1.5)
            continue

        if choice == "1":
            cmd = ["nmap", "-F", "-sV", target]
            output_args = choose_output_mode("quick_scan", target)
        elif choice == "2":
            cmd = ["nmap", "-sS", "-p-", "-sV", target]
            output_args = choose_output_mode("full_scan", target)
        elif choice == "3":
            cmd = ["nmap", "-sU", "--top-ports", "200", target]
            output_args = choose_output_mode("udp_scan", target)
        elif choice == "4":
            cmd = ["nmap", "--script", "vuln", target]
            output_args = choose_output_mode("vuln_scan", target)
        elif choice == "6":
            if shutil.which("masscan") is None:
                print(C.BLOOD + "[!] Masscan not installed" + C.RESET)
                time.sleep(2)
                continue

            output_args = choose_output_mode("mass_scan", target)

            rate = input("Masscan rate (default 1000) >> ").strip() or "1000"
            cmd = ["masscan", target, "-p1-65535", "--rate", rate]

            saved_file = None
            if output_args:
                if output_args[0] == "-oN":
                    cmd += ["-oL", output_args[1]]
                    saved_file = output_args[1]
                elif output_args[0] == "-oA":
                    cmd += ["-oL", output_args[1] + ".txt"]
                    saved_file = output_args[1] + ".txt"

            # Auto sudo for Linux
            if not IS_WINDOWS and hasattr(os, "geteuid") and os.geteuid() != 0:
                cmd = ["sudo"] + cmd

            run_command(cmd, saved_file)
            continue
        else:
            continue

        saved_file = None
        if output_args:
            cmd += output_args
            saved_file = output_args[1]

        run_command(cmd, saved_file)

if __name__ == "__main__":
    check_dependencies()
    main_menu()
