# =========================
# UTILS
# =========================
def get_file_hash(path):
    if not os.path.exists(path):
        return None
    sha256 = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(4096), b""):
            sha256.update(chunk)
    return sha256.hexdigest()

def resolve_host(target):
    try:
        ip = socket.gethostbyname(target)
        return ip
    except Exception:
        return None

def geo_ip(ip):
    try:
        with urllib.request.urlopen(f"https://ipinfo.io/{ip}/json") as response:
            data = json.load(response)
            return f"{data.get('city','')}, {data.get('region','')}, {data.get('country','')}"
    except:
        return "Geolocalizzazione non disponibile"

# =========================
# UPDATE
# =========================
def update_script(auto=False):
    if not auto:
        print("\n[+] Checking updates...")

    try:
        with urllib.request.urlopen(GITHUB_RAW_URL, timeout=10) as response:
            latest_script = response.read()

        if hashlib.sha256(latest_script).hexdigest() == get_file_hash(SCRIPT_PATH):
            if not auto:
                print("[=] Already updated.")
            return

        print("[+] New version found!")
        backup = SCRIPT_PATH + ".bak"
        if os.path.exists(SCRIPT_PATH):
            os.replace(SCRIPT_PATH, backup)

        temp = SCRIPT_PATH + ".tmp"
        with open(temp, "wb") as f:
            f.write(latest_script)

        os.replace(temp, SCRIPT_PATH)
        print("[✔] Update done! Restart script to apply changes.")

    except Exception as e:
        if not auto:
            print(f"[!] Update error: {e}")

    time.sleep(2)

# =========================
# SCAN BUILDERS
# =========================
def build_scan(target, scan_type):
    if scan_type == "quick":
        return ["nmap", "-F", "-sV", "-oN", f"quick_{target}.txt", target]
    elif scan_type == "full":
        cmd = ["nmap", "-sS", "-p-", "-sV", "-oN", f"full_{target}.txt", target]
        if not IS_WINDOWS: cmd.insert(0, "sudo")
        return cmd
    elif scan_type == "udp":
        cmd = ["nmap", "-sU", "--top-ports", "200", "-oN", f"udp_{target}.txt", target]
        if not IS_WINDOWS: cmd.insert(0, "sudo")
        return cmd

# =========================
# PARSER PORTE
# =========================
def parse_nmap_output(file_path):
    if not os.path.exists(file_path):
        print(f"[!] File {file_path} non trovato")
        return
    print("\n[+] Risultati evidenziati:")
    with open(file_path,"r") as f:
        for line in f:
            line = line.strip()
            match_open = re.match(r"(\d+)/tcp\s+open", line)
            match_udp = re.match(r"(\d+)/udp\s+open", line)
            if match_open:
                port = match_open.group(1)
                label = CRITICAL_PORTS.get(port,"")
                print(f"\33[32m[OPEN] {port}/tcp {label}\33[0m")
            elif match_udp:
                port = match_udp.group(1)
                label = CRITICAL_PORTS.get(port,"")
                print(f"\33[34m[OPEN] {port}/udp {label}\33[0m")
            elif re.match(r"\d+/tcp\s+closed", line):
                print(f"\33[31m[CLOSED] {line}\33[0m")

# =========================
# SCAN EXECUTOR
# =========================
def run_nmap(command):
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    output_file = None
    for i,arg in enumerate(command):
        if arg.startswith("-oN") and i+1<len(command):
            output_file = command[i+1]

    with tqdm(total=100, desc="Scanning", unit="%") as pbar:
        for line in process.stdout:
            print(line.strip())
            match = re.search(r"(\d+)% done", line)
            if match:
                pbar.n = int(match.group(1))
                pbar.refresh()
        process.wait()

    if output_file:
        parse_nmap_output(output_file)

# =========================
# RUN SCAN MENU
# =========================
def run_scan(choice):
    if shutil.which("nmap") is None:
        print("[!] Nmap non installato")
        return

    target = input("Inserisci target (IP o dominio): ").strip()

    ip = resolve_host(target)
    print(f"[+] IP target: {ip if ip else 'Non risolvibile'}")

    if ip:
        print(f"[+] Geolocalizzazione: {geo_ip(ip)}")

    if choice == "1":
        cmd = build_scan(target, "quick")
    elif choice == "2":
        cmd = build_scan(target, "full")
    elif choice == "3":
        cmd = build_scan(target, "udp")
    else:
        print("Scelta non valida")
        return

    print("\n[+] Avvio scansione...\n")
    run_nmap(cmd)

    print("\n[✔] Scan completata.")

