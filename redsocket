class C:
    BLOOD = "\033[38;2;139;0;0m"
    BLOOD_BOLD = "\033[1;38;2;139;0;0m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    CYAN = "\033[36m"
    RESET = "\033[0m"

# =========================
# DEPENDENCY CHECK
# =========================
def check_dependencies():
    if shutil.which("nmap") is None:
        print(C.BLOOD + "[!] Nmap not installed" + C.RESET)
        print("Install it from https://nmap.org/download.html")
        sys.exit(1)

# =========================
# INPUT / TERMINAL CONTROL
# =========================
def flush_input():
    try:
        if IS_WINDOWS:
            import msvcrt
            while msvcrt.kbhit():
                msvcrt.getch()
        else:
            import termios
            termios.tcflush(sys.stdin, termios.TCIFLUSH)
    except:
        pass

def disable_input():
    if IS_WINDOWS:
        return None
    try:
        import termios, tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)
        return old
    except:
        return None

def restore_input(old_settings):
    if IS_WINDOWS or old_settings is None:
        return
    try:
        import termios
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_settings)
    except:
        pass

# =========================
# UTILS
# =========================
def clear():
    os.system("cls" if IS_WINDOWS else "clear")

def resolve_host(target):
    try:
        return socket.gethostbyname(target)
    except:
        return None

# =========================
# LOGGING
# =========================
def log_command(cmd):
    try:
        with open(LOG_FILE, "a") as f:
            f.write(f"[{datetime.now()}] {' '.join(cmd)}\n")
    except:
        pass

# =========================
# OUTPUT MANAGEMENT
# =========================
def get_desktop_path():
    home = os.path.expanduser("~")
    desktop = os.path.join(home, "Desktop")
    return desktop if os.path.isdir(desktop) else home

def generate_output_base(prefix, target):
    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    safe_target = target.replace(":", "_").replace("/", "_").replace(".", "_")
    return os.path.join(get_desktop_path(), f"{prefix}_{safe_target}_{timestamp}")

def choose_output_mode(prefix, target):
    print("\nSave results?")
    print("1 - Normal output (-oN)")
    print("2 - All formats (-oA)")
    print("3 - Do not save")

    choice = input(">> ").strip()

    if choice == "3":
        return None

    base = generate_output_base(prefix, target)

    if choice == "1":
        return ["-oN", base + ".txt"]

    if choice == "2":
        return ["-oA", base]

    return None

