# =========================
# MAIN MENU
# =========================
def main_menu():
    while True:
        print("=== Menu Principale ===")
        print("1 - Quick TCP Scan")
        print("2 - Full TCP Scan")
        print("3 - UDP Scan")
        print("4 - Update")
        print("5 - Help")
        print("0 - Exit")

        choice = input(">> ").strip()
        if choice in ["1","2","3"]: run_scan(choice)
        elif choice=="4": update_script()
        elif choice=="5": show_help()
        elif choice=="0": sys.exit(0)
        else: print("Opzione non valida.")

# =========================
# START
# =========================
if __name__=="__main__":
    print_banner()
    update_script(auto=True)
    main_menu()
