# =========================
# MENU
# =========================
def main_menu():
    while True:
        print("\n=== RedSocket Menu ===")
        print("1 - Scan")
        print("2 - Update")
        print("3 - Help")
        print("0 - Exit")

        choice = input(">> ").strip()

        if choice == "1":
            run_scan()
        elif choice == "2":
            update_script()
        elif choice == "3":
            show_help()
        elif choice == "0":
            sys.exit(0)
        else:
            print("Opzione non valida")


# =========================
# START
# =========================
if __name__ == "__main__":
    print_banner()
    update_script(auto=True)
    main_menu()
