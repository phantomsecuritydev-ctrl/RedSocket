# =========================
# HASH
# =========================
def get_file_hash(path):
    if not os.path.exists(path):
        return None

    sha256 = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(4096), b""):
            sha256.update(chunk)
    return sha256.hexdigest()


# =========================
# VERSION CHECK
# =========================
def extract_version(content_bytes):
    try:
        content = content_bytes.decode()
        match = re.search(r'VERSION\s*=\s*["\'](.+?)["\']', content)
        if match:
            return match.group(1)
    except:
        pass
    return None


# =========================
# UPDATE PRO
# =========================
def update_script(auto=False):
    if not auto:
        print("\n[+] Checking for updates...")

    try:
        with urllib.request.urlopen(GITHUB_RAW_URL, timeout=10) as response:
            latest_script = response.read()

        latest_hash = hashlib.sha256(latest_script).hexdigest()
        local_hash = get_file_hash(script_path)

        latest_version = extract_version(latest_script)

        if local_hash == latest_hash:
            if not auto:
                print("[=] Already up to date.")
            return

        print(f"[+] New version found: {latest_version or 'unknown'}")

        # Backup
        backup = script_path + ".bak"
        if os.path.exists(script_path):
            os.replace(script_path, backup)

        # Scrittura sicura
        temp = script_path + ".tmp"
        with open(temp, "wb") as f:
            f.write(latest_script)

        os.replace(temp, script_path)

        print("[✔] Update completed!")
        print("Riavvia lo script per usare la nuova versione.")

    except Exception as e:
        if not auto:
            print(f"[!] Update error: {e}")

    time.sleep(2)


# =========================
# NMAP COMMAND BUILDER
# =========================
def build_nmap_command(choice, target, output_file):
    if choice == "1":  # quick
        return ["nmap", "-F", "-sV", "-oN", output_file, target]

    elif choice == "2":  # full
        cmd = ["nmap", "-sS", "-p-", "-sV", "-oN", output_file, target]
        if not IS_WINDOWS:
            cmd.insert(0, "sudo")
        return cmd

    elif choice == "3":  # UDP
        cmd = ["nmap", "-sU", "--top-ports", "200", "-oN", output_file, target]
        if not IS_WINDOWS:
            cmd.insert(0, "sudo")
        return cmd

    return None


# =========================
# RUN NMAP
# =========================
def run_nmap(command):
    process = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )

    with tqdm(total=100, desc="Scanning", unit="%") as pbar:
        for line in process.stdout:
            print(line.strip())

            match = re.search(r"(\d+)% done", line)
            if match:
                percent = int(match.group(1))
                pbar.n = percent
                pbar.refresh()

        process.wait()


# =========================
# SCAN
# =========================
def run_scan():
    print_banner()

    if shutil.which("nmap") is None:
        print("[!] Nmap non installato.")
        return

    target = input("Target (IP/Dominio): ").strip()
    filename = f"scan_{target}.txt"

    print("\nTipi di scansione:")
    print("1 - Quick")
    print("2 - Full")
    print("3 - UDP (lenta)")

    choice = input("Scelta: ").strip()

    command = build_nmap_command(choice, target, filename)

    if not command:
        print("Scelta non valida")
        return

    print("\n[+] Avvio scansione...\n")
    run_nmap(command)

    print("\n[✔] Scan completata")
    print(f"[+] File salvato: {filename}")


